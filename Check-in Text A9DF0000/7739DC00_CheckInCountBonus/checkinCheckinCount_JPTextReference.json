	"text_info": [
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン100日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nノビノビタケノコ　を　ゲットしました！\nしゅっせいダケ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン200日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nグレートプレート　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン300日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nグレートブーツ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン400日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nワンダーバッジ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン500日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nワンダーブーツ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン600日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nワンダーマント　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン700日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティまおうふく　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン800日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティじゃがん　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン900日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティなあし　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1000日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティなかざり　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1100日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティなつめ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1250日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nプリティマント　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1400日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのよろい　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1550日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのかぶと　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1700日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのまもり　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン1850日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのこて　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン2000日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのくつ　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お知らせ\nチェックイン2150日にち以上いじょうありがとう！\n記念きねんアイテムをプレゼント！！\n\nりゅうきしのやり　を　ゲットしました！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		}
	],
