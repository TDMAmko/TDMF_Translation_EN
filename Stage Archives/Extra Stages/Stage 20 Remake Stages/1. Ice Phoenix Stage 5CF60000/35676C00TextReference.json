	},
	"text_info": [
		{
			"text_contents": "なし",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "我われは「{9, MonsterParameter, +}<2ü耀>{3, name, +}」\n「氷こおりの化身けしん」の力ちからを受うけ継つぎし存在そんざい。\nこの力ちから、電波でんぱ人間にんげんで試ためしたかった所ところだ。\nよかろう！貴様きさまの相手あいてをしてやる！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ククッ、逃にげずに立たち向むかってくるか。\nその気概きがいは誉ほめてやるが\n恐怖きょうふの中なかで絶望ぜつぼうし悔くいるがいい！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "逃にげるのか？まあそれもよかろう。\n私わたしはかつての父ちち以上いじょうに強つよいからな。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "懲こりずに挑いどむか……ククッ。\nならばその選択せんたく、後悔こうかいさせてやる！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ありえぬ……あってたまるかっ。\n電波でんぱ人間にんげんごときに、この、私わたしが……ぐあああっ。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "プヒ！僕ぼく「{8, MessageNpcName, +}<2O耀>{4, message}」プヒ！\nみんなとはぐれて寂さみしかったプヒ……。\nだから君きみと一緒いっしょに旅たびをさせて欲ほしいプヒ。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ありがとうプヒ！これでもう寂さみしくないプヒ！\n先さきに君きみの島しまへ行いってるプヒ！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ありがとプヒ……でもキミの\n電波でんぱ人間にんげんボックスが空あいてないプヒ。\n空あいたらまた声こえを掛かけて欲ほしいプヒ！\n寂さみしいけど、ここで待まってるプヒ！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "駄だ目めプヒか……残念ざんねんプヒ。\n一緒いっしょに行いきたかったプヒ。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "先さきに君きみの島しまへ行いってるプヒ！\n気きを付つけて帰かえってくるプヒ！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "電波でんぱ人間にんげんボックスに空あきが出で来きたら\nまた声こえを掛かけて欲ほしいプヒ！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "プヒ！連つれてってくれるプヒ？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
	],
