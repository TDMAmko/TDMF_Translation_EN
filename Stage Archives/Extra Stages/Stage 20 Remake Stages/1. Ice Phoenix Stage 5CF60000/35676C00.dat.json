	"text_info": [
		{
			"text_contents": "none",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "We are \"<17\u0003>{9, MonsterParameter, +}<2ü耀>{3, name, +}\", beings\nwho inherited the power of<1\"\u0000>\nthe \"Incarnation of Ice\".\nWe've been waiting to test<1\"\u0000>\nthis power on Denpa Men.\nVery well, we'll be<1\"\u0000>\nyour opponent!!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Heh, so you're not running\naway - you're coming at us<1\"\u0000>\nhead-on? We'll give you\ncredit for that spirit,<1\"\u0000>\nbut you'll fall in despair\nand regret your reckless<1\"\u0000>\ndecision after being\nengulfed in fear!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Are you going to run away?\nWell, that's fine, we suppose.<1\"\u0000>\nAfter all, we are stronger\nthan our father ever was.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "You still didn't learn your\nlesson and dare to challenge<1\"\u0000>\nus again... Heh. Well then,\nwe'll make you regret<1\"\u0000>\nthat foolish choice!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "No way... There's no way such\na thing could happen.<1\"\u0000>\nFor someone like a Denpa\nMen to...us... Gaah!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Phee! I'm <17\u0003>{8, MessageNpcName, +}<2O耀>{4, message}, phee!<1\"\u0000>\nI got separated from\neveryone and now feel so<1\"\u0000>\nlonely, phee... So, I wish\nto travel with you, phee.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thank you, phee! Now I won't be\nlonely anymore, phee! I'm<1\"\u0000>\nheading to your island, phee!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thanks, phee...but your Denpa\nMen Box is full right now.<1\"\u0000>\nIf you have a free spot,\nI'd love for you to<1\"\u0000>\nreach out to me again, phee!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Oh, no, phee... That's too\nbad, phee... I wanted to<1\"\u0000>\ngo with you, phee.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm heading to your island\nfirst, phee! Take care and come<1\"\u0000>\nback safely, phee!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "If you have an available spot\nin the Denpa Men Box,<1\"\u0000>\nI'd love for you to reach\nout to me again, phee!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Phee! Are you willing to take\nme along, phee?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
