	"text_info": [
		{
			"text_contents": "Fight the Guardians?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I am one of the Guardians.\n\"<17\u0003>{9, MonsterParameter, +}<2͵耀>{3, name, +}\".<1\"\u0000>\nIf you wish to fight us,\ntalk to \"<17\u0003>{9, MonsterParameter, +}<2o耀>{3, name, +}\".",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I am one oft he Guardians.\n\"<17\u0003>{9, MonsterParameter, +}<2n耀>{3, name, +}\".<1\"\u0000>\nIf you intend to fight us,\ntalk to \"<17\u0003>{9, MonsterParameter, +}<2o耀>{3, name, +}\".",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I am the strongest of the\nGuardians. \"<17\u0003>{9, MonsterParameter, +}<2o耀>{3, name, +}\".<1\"\u0000>\nAs Guardians of this world,\nwe were keeping an eye on the<1\"\u0000>\nactions of \"<17\u0003>{9, MonsterParameter, +}<2»耀>{3, name, +}\".\nOur obligation is also to<1\"\u0000>\ndetermine whether you, too,\nare worthy to be a guardian<1\"\u0000>\nto this world. Now, show us\nyour power, Denpa Men!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "All right, then. Go ahead and\ngive it your all.<1\"\u0000>\nWe three will go together\nagainst you at once!<1\"\u0000>\nWe will give it our all\nto testify exactly what you<1\"\u0000>\nare made of!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "We do not mind youo backing\ndown at all. Feel free to<1\"\u0000>\nchallenge us whenever\nyou are ready.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Are you ready to challange us?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Marvelously done, Denpa Man.\nVery admireable. May that<1\"\u0000>\nrighteous power be used for\nthe good of the world.<1\"\u0000>\nIt truly was a brilliant\nbattle...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Whoa! That really took me by\nsurprise!<1\"\u0000>\nOh, my apologies. I'm \"<17\u0003>{8, MessageNpcName, +}<2R耀>{4, message}\".\nI travel day after day,<1\"\u0000>\nin search of new wonders.\nWould you care to take me<1\"\u0000>\nalong as your traveling\ncompanion from time to time?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Oh! I see!\nWell then, let's head<1\"\u0000>\nstraight to your island\nnow. Ahaha! Did that catch you<1\"\u0000>\nby surprise? Well, shouldn't we<1\"\u0000>\nhurry? Anyway, I'll then be\nwaiting for you on the island!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What!? That's amazing! There are\nno free spots in the Denpa<1\"\u0000>\nMen Box. If ya have a free\nspot, feel free to pay a visit<1\"\u0000>\nto me again. Of course,<1\"\u0000>\nnext time I won't act\nsurprised.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What the? I didn't expect to be\nturned down! Well, if you<1\"\u0000>\nfeel like chaning your mind,\ngive me a shout.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm heading directly to your\nisland! I'll be waiting for<1\"\u0000>\nyour return!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "If ya have a free spot in the\nDenpa Men Box, feel free<1\"\u0000>\nto give me a thumbs up.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Whoa!? That really surprised\nme!! So, are you thinking of<1\"\u0000>\ntaking me with you?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
	],
