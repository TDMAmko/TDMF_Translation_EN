	"text_info": [
		{
			"text_contents": "なし",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "黒くろいイカ戦士せんしを見みたら逃にげるんだな。\nとても、かないっこないぜ……。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "くくくっ、更さらなるパワーアップを果はたした私わたしこそは\n「{9, MonsterParameter, +}<2{耀>{3, name, +}」改あらため「{9, MonsterParameter, +}<2|耀>{3, name, +}」！\n電波人間でんぱにんげん！\n{9, MonsterParameter, +}<2»耀>{3, name, +}を倒たおしたようだな。\n一応いちおうほめてやろう。\nどうだ、嬉うれしいだろう！？\nだがな、本来ほんらいは……この私わたしが！\nやっつけるはずだったんだ！！\n私わたしが本気ほんきになれば、{9, MonsterParameter, +}<2»耀>{3, name, +}はおろか……\nくくくっ、お前まえごときケチョンケチョンだ！！\n今回こんかいの私わたしはすごいぞ！\nこの薄暗うすぐらい場所ばしょで更さらなるトレーニングを重かさね\n最強さいきょうの私わたしが超最強ちょうさいきょうになってしまった！！\n自じ己こベストも更新こうしんだからな！！！！\nこの前まえはあかりがいた手前てまえ、我慢がまんしていたが\nちょうどいい……ここでケリをつけてやろう！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "逃にげ出だせばいいものを、身みの程ほど知しらずが……。\nとくと後悔こうかいするがいい！！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "やはり、{9, MonsterParameter, +}<2|耀>{3, name, +}となった\n私わたしは恐おそろしいようだな……くくくっ。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "何なんだ？\n性懲しょうこりもなく挑いどみに来きたか。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "くっ、まだ完全かんぜんに回復かいふくはしていなかったか。\nまたしても、電波でんぱ人間にんげんに、負まけっ……。\nいや、負まけてなどいない！\n心こころが折おれなければ、負まけたことには！！\nぐぬぬ、これで勝かったと思おもうなよおおお！！！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "これはどうもです。「{8, MessageNpcName, +}<2N耀>{4, message}」です。\nはじめましてです。\nひとりぼっちになってしまい困こまってますです。\nいっしょに連つれていってほしいです。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "っ！？ありがとうございますです！\nさっそくあなたの島しまにいきますです。\nお帰かえりを待まってますです。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "っ！？電波でんぱ人間にんげんボックスに\n空あきがない……です。\n空あいたらまた声こえ、かけて欲ほしいです。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "っ！？だめ、ですか……。\nひとりぼっちはさみしいです……。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "さっそくあなたの島しまにいきますです。\nあなたが帰かえってきたら\nぜひ冒険ぼうけんに連つれていってほしいです。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "電波でんぱ人間にんげんボックスに空あきが出で来きたら\n声こえ、かけて欲ほしいです。待まってるです。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "っ！？連つれてってほしいです……！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
