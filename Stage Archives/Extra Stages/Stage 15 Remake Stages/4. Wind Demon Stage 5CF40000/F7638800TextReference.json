	"text_info": [
		{
			"text_contents": "私わたしは風かぜの妖精ようせい{8, MessageNpcName, +}<2=耀>{4, message}。\n「{5, ItemData, +}<2³耀>{3, name, +}」を手てにした者ものよ。\nあなたを待まっておりました。\n証あかしを手てにした者ものには私わたしの力ちからを\n惜おしみなく貸かしましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "これからよろしくお願ねがいします。\nでは、私わたしは先さきにあなたの島しまへ参まいります。\nあなたが無ぶ事じ、島しまへ戻もどられることを\n心こころから祈いのっております。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "……良よいお返事へんじは\n大変たいへんうれしいのですが。\n残念ざんねんながらあなたの電波人間でんぱにんげんボックスに\n空あきがないようです。\n電波人間でんぱにんげんボックスの枠わくが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "そうですか……。\n私わたしの力ちからは、不要ふようのようですね。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしは先さきにあなたの島しまへ参まいります。\nあなたが島しまに戻もどりましたら\n今後こんごの冒険ぼうけんに私わたしの力ちからを役立やくだてましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "電波人間でんぱにんげんボックスが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしの力ちからが、必要ひつようになりましたか？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Zzz……。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "…………………ふが？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
