	"text_info": [
		{
			"text_contents": "Well met!\nI am <17\u0003>{9, MonsterParameter, +}<2ı耀>{3, name, +}.<1\"\u0000>\nYou're the one who defeated\nmy younger brother<1\"\u0000>\nPenguin Lord, right?\nHahaha! I was once defeated<1\"\u0000>\nby my younger brother and\nbanished to the Inferno but<1\"\u0000>\n<17\u0003>{9, MonsterParameter, +}<2»耀>{3, name, +} has granted me\nresurrection and returned me<1\"\u0000>\nto this world. Now that\nI have returned, I'll turn the<1\"\u0000>\nwhole world into a frozen\nwasteland of extreme cold!<1\"\u0000>\nYou'll be able to skate all\nyear round! Rejoice! Gahaha!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Are you defying me!? Ugh!\nI'll make you regret this!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Are you afraid of me standing\nin front of me? Gahaha!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What is it?\nI don't need you right now!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I lost...\nDarn it...darn it...!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Uuuuuu...\nMy name is <17\u0003>{8, MessageNpcName, +}<2M耀>{4, message}...<1\"\u0000>\nUuuugh...I'm soo hungry...\nI feel like I'm going to <1\"\u0000>\nstarve... There's nothing...\nto eat here. You...take me<1\"\u0000>\nsomewhere...to a place\nwith lots of food.<1\"\u0000>\nPlease...take me\nwith you!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "uuuu...Thanks.\nYou're a good guy...<1\"\u0000>\nI'm heading to your island\nfirst. Come back soon...<1\"\u0000>\nMake sure to have...something\nto eat ready.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Uuuuu...Thanks.<1\"\u0000>\n...but your Denpa Men Box\nhas no space left, I can't<1\"\u0000>\ngo in. Come back when you\nhave space there.<1\"\u0000>\nYou absolutely have to come\nback and call out to me.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Uuu...I'm so hungry...\nI'm sooo huuungry...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm heading to your island.\nCome back soon...<1\"\u0000>\nMake sure you have\nsomething to eat ready.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Your Denpa Men Box isn't having\na free spot. If it has a<1\"\u0000>\nfree spot, make sure to\ncome back to me. You must<1\"\u0000>\nabsolutely come back to me.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm soooo hungry...\nPlease take me with you.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
