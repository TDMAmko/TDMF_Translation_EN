	"text_info": [
		{
			"text_contents": "なし",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしは電気でんきの妖精ようせい{8, MessageNpcName, +}<2?耀>{4, message}。\n「{5, ItemData, +}<2µ耀>{3, name, +}」を手てにした者ものの\n到来とうらいを待まっておりました。\n証あかしを手てにした者ものよ。あなたの冒険ぼうけんに\n微力びりょくながら、私わたしの力ちからをお貸かししましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "これからよろしくお願ねがいしますね。\nでは、私わたしは先さきにあなたの島しまへ参まいります。\nあなたが無ぶ事じ、島しまへ戻もどられることを\n心こころから祈いのっております。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "これからよろしくお願ねがい……あら？\n残念ざんねんながらあなたの電波人間でんぱにんげんボックスに\n空あきがないようです。\n電波人間でんぱにんげんボックスの枠わくが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "そうですか……。\n残念ざんねんですが、仕方しかたありません。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしは先さきにあなたの島しまへ参まいります。\nあなたが島しまに戻もどりましたら\n今後こんごの冒険ぼうけんに私わたしの力ちからを役立やくだてましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "電波人間でんぱにんげんボックスが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしの力ちからが、必要ひつようになりましたか？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "おれは、{9, MonsterParameter, +}<2Ÿ耀>{3, name, +}！\n女王じょおうに命めいじられて妖精ようせいの宝たからをずっと守まもっている。\nだーれも来こないので退屈たいくつしていたところだ。\n退屈たいくつしのぎにちょうどいい。\n俺おれと勝負しょうぶしてお宝たからゲットして行いきなよ？な！\nあ、戦たたかうならクリティカルには期待きたいするなよ！\nおれ「まぼろし」って能力のうりょくもちだから\nクリティカル攻撃こうげきは受うけないぜ！\nほら、こんだけ重要じゅうようなヒントくれてやったんだから\n勝負しょうぶに付つき合あえよ、な！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "そうこなくっちゃ！\nちょうど放電ほうでんしないとヤバいところだったし。\nそんじゃ、いっちょシビレるバトルといきますか！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ちぇー……だめかー……。\nあーあ、誰だれか俺おれのヒマ潰つぶしに\n付つき合あってくれるヤツはいねーかなー！",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "お？お？\nその気きになった？バトルする気きになった？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "ちょー楽たのしかったなー……。\nさすが女王じょおうが見み込こんだだけのことはあるな。\nよし！\nもってけ泥棒どろぼう！！\nあーでも……。\nやっぱ負まけるのは悔くやしいなあ……。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
	],
