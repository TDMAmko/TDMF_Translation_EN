	"text_info": [
		{
			"text_contents": "What in the world are you\nDenpa Men doing in my forest!<1\"\u0000>\nHuh? I'm the commander of the\narmy of his lordship, the<1\"\u0000>\nArmy of Darkness! If you get\ninto the way of the Army<1\"\u0000>\nof Darkness, I have no other\nchoice but to get rid of you!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "You little Denpa weirdos, you\nthink you can defy me!<1\"\u0000>\nHuh, get ready to learn\nhow terrifying I am!!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hahaha! Run away!\nGet out of my forest!!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What in the world!? Do you not\nhave any shame, you really<1\"\u0000>\ncame back to pick a fight\nagainst me?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Darn it... Defeated by silly\nlittle Denpa Men.<1\"\u0000>\nIn my own forest...\nMy army...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hey, what are you doing\nhere, boo! Are you lost, boo?<1\"\u0000>\nYou're not lost, right, boo!?\nPlease bring me with you, boo!<1\"\u0000>\nI'm \"<17\u0003>{8, MessageNpcName, +}<2K耀>{4, message}\", boo.\nI can be a great help<1\"\u0000>\nfor your team, boo!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thank you! Boo? Can you just\nshow me the exit so I know<1\"\u0000>\nhow to get to your island, boo?\nI will meet you there<1\"\u0000>\nthen, see you boo!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thank you! Boo? Can you just\nshow me the exit so I know<1\"\u0000>\nhow to get to your island, boo?\nOh, I see you have no more<1\"\u0000>\nspace for me, boo... If there's\nno space, I can't stay at your<1\"\u0000>\nisland, even if I manage\nto get there boo...<1\"\u0000>\nCan you please come back\nwhen you have a free spot. Boo!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "No good, boo... You seem to be\nnin a hurry, boo.<1\"\u0000>\nI guess I can't help it, boo.\nI have to find the exit<1\"\u0000>\nby myself I suppose, boo...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm waiting for you in the\nDenpa Men Box, boo! After you<1\"\u0000>\ncome back, feel free to add\nme to your \"Party\", boo.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "If you have a free spot in\nthe Denpa Men Box, let me<1\"\u0000>\nknow, boo. Stay safe for now\nboo!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I really want you to help me\nout of here boo...<1\"\u0000>\nIs that okay boo...\n...to help me boo?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me heard, rumor, golden doors\naround world. Beyond golden<1\"\u0000>\ncan find incredible treasure.\nBut door not open without<1\"\u0000>\nusing special key.\nMe searching for these doors,<1\"\u0000>\nbut paths complicated and\nfull of monsters.<1\"\u0000>\nCan't make any progress.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Oh, me got lost and can't\nfind way back. Me hear,<1\"\u0000>\nloud animal growling deep\ninside forest...scary.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
	],
