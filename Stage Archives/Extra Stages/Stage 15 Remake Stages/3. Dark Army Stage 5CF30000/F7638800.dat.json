	"text_info": [
		{
			"text_contents": "I am the Fire Fairy <17\u0003>{8, MessageNpcName, +}<2;耀>{4, message}.<1\"\u0000>\nI have been eagerly awaiting\nthe bearer of the \"<17\u0003>{5, ItemData, +}<2±耀>{3, name, +}.<1\"\u0000>\nOh bearer of the token,\nlet me lend you my strength<1\"\u0000>\nfor your adventures.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Please take good care of me.\nI will go to your island first.<1\"\u0000>\nI sincerely hope for your\nsafe return to your island!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I am truly grateful for your\nkind reply but unfortunately<1\"\u0000>\nthere is no room left for me\nin the Denpa Men Box.<1\"\u0000>\nPlease let me know if a free\nspot opens up in your<1\"\u0000>\nDenpa Men Box.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I see...\nI really wanted to be<1\"\u0000>\nof help to you.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I will go ahead to your island\nfirst. When you return to your<1\"\u0000>\nisland, I will lend you my\npower for your adventures.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "If a spot opens up in the\nDenpa Men Box, please<1\"\u0000>\nlet me know.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Is my help needed now?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
