	"text_info": [
		{
			"text_contents": "私は火ひの妖精ようせい{8, MessageNpcName, +}<2;耀>{4, message}。\n「{5, ItemData, +}<2±耀>{3, name, +}」を手てにした者ものが訪おとずれることを\n心待こころまちにしておりました。\n証あかしを手てにした者ものよ。\nあなたの冒険ぼうけんに私わたしが力ちからをお貸かししましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "どうぞよろしくお願ねがいします。\nでは、私わたしは先さきにあなたの島しまへ参まいります。\nあなたが無ぶ事じ、島しまへ戻もどられることを\n心こころから祈いのっておりますよ。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "せっかく良いいお返事へんじを頂いただいて\n恐縮きょうしゅくなのですが……。\n残念ざんねんながら、あなたの電波人間でんぱにんげんボックスに\n空あきがないようです。\n電波人間でんぱにんげんボックスの枠わくが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "そうですか……。\nあなたのお役やくに立たちたかったのですが。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしは先さきにあなたの島しまへ参まいります。\nあなたが島しまに戻もどりましたら\n今後こんごの冒険ぼうけんに私わたしの力ちからを役立やくだてましょう。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "電波人間でんぱにんげんボックスが空あきましたら\nまた、私わたしに声こえを掛かけてください。",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "私わたしの力ちからが、必要ひつようになりましたか？",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
