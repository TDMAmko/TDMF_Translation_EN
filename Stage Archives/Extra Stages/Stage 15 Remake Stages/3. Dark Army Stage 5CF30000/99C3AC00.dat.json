	"text_info": [
		{
			"text_contents": "none",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm <17\u0003>{9, MonsterParameter, +}<2˓耀>{3, name, +}.<1\"\u0000>\nI was commanded by\n<17\u0003>{9, MonsterParameter, +}<2»耀>{3, name, +} to cover<1\"\u0000>\nthe world full in darkness.\nThese great eyes can see<1\"\u0000>\nright through you. You who\npossess the <17\u0003>{5, ItemData, +}<2Ö耀>{3, name, +}<1\"\u0000>\nand came to this place, I can\nsee your future.<1\"\u0000>\nI can see you as you wither\nand perish on this land...<1\"\u0000>\nThe future cannot be changed.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Yes, I see you're ready for\nyour fate.<1\"\u0000>\nWelcome...I'll plunge you\ninto despair in an instant.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hehe, it's all right. You are\nscared, arent't you?<1\"\u0000>\nDon't worry, I'll allow you\nsome time. Even if this changes<1\"\u0000>\nthe timing of your fate,\nit is sealed anyway.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Are you ready?\nDenpa men.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "There's no way...the future...\ncan change...it is impossible...<1\"\u0000>\nI won't accept...that...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm the thief \"<17\u0003>{8, MessageNpcName, +}<2Q耀>{4, message}\"!\nI snuck in here to look<1\"\u0000>\nfor some treasure, meow!\nBut the guys around here<1\"\u0000>\nare super strong, meow!\nBut you seem to be doing<1\"\u0000>\njust fine, meow! That's amazing,\nmeow. That means you must<1\"\u0000>\nhave some great gear, right?\nDon't worry, you won't<1\"\u0000>\nneed to share your gear\nwith me, meow...I just<1\"\u0000>\nwant to learn from you, meow!\nPlease take me with you, meow!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thanks, meow! Now I have the\nchance to steal rare gear<1\"\u0000>\nwhenever I want... Oh, I said\nnothing, meow! You're not<1\"\u0000>\njust strong but you also have\na big heart too, meow!<1\"\u0000>\nNow, let me head to your\nisland first, meow!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thanks, meow!<1\"\u0000>\n...Huh? There's no free space\nin your Denpa Men Box, meow!<1\"\u0000>\nThis means I can't join you\nuntil you don't have a free<1\"\u0000>\nspot for me, meow! Please\ncome back when you have a free<1\"\u0000>\nspot. I definitely want to\nbe part of your team, meow...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Meouuuw!! Was that a no, meow!?\nOh...I guess no rare gear<1\"\u0000>\nfor me to nab anytime soon...\nI mean I actually just want<1\"\u0000>\nto join you on your\nadventures, meow.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm heading straight to your\nisland, meow! When you return,<1\"\u0000>\nI want you to add me\nto your party so that<1\"\u0000>\nI can go on adventures\nwith you, meow!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "If there's ever a free spot\nin your Denpa Men Box, I would<1\"\u0000>\nlove to occupy it. Just\ncome back to me when<1\"\u0000>\nyou have a free spot, meow!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Meow!? Did you change your\nmind, meow?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": false,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": true
		}
