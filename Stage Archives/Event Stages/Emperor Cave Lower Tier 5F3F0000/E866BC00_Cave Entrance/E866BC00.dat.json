	"text_info": [
		{
			"text_contents": "If go down stairs, enter cave,\ncan not come back here.<1\"\u0000>\nIf need anything, please\nbuy here before go.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Cave ahead, mysterious place,\nscenery and monsters who<1\"\u0000>\nappear, change time to time.\nAccording to someone else,<1\"\u0000>\nwho go there recently,\nstructure changed again.<1\"\u0000>\nBeside volcanic region,\ninherited by fire-type monster,<1\"\u0000>\nalso areas with water and\nice reported. If plan<1\"\u0000>\ngo further, make sure,\nwell prepared.<1\"\u0000>\nMe honest, this cave never\nfail, amaze me.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me been to cave several times\nnow, but for some reason,<1\"\u0000>\nevery single time, when\ngo, end up in different place.<1\"\u0000>\nWhen take stairs down,\njust disappear next floor.<1\"\u0000>\nThis cave, really creepy...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "This place, just recently\ndiscovered. But me wonder,<1\"\u0000>\nwhere leads to?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Made it partway through cave,\nbut encountered very strong<1\"\u0000>\nenemy. Me decided, run\naway and come back!<1\"\u0000>\nHad \"<17\u0003>{5, ItemData, +}<2\u001E耀>{3, name, +}\" with me, really\nsaved me! You too, should get<1\"\u0000>\nfew of those!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
