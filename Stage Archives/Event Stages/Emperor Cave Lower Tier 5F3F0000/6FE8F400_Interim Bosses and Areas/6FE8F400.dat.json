	"text_info": [
		{
			"text_contents": "Gah! Gah! What is this!\nWhat kind of tiny little<1\"\u0000>\ngremlin is this? Huh? Gah!\nLooks like it wandered<1\"\u0000>\nin here by mistake! Whoa,\nI'm not letting you go<1\"\u0000>\nany further!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Huh? You wanna take me on?\nDon't say I didn't warn you!<1\"\u0000>\nGah! Gah!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gah! Gah! That's right, crawl\nback to your home quietly!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gah! Gah! What now?\nYou're back again!?<1\"\u0000>\nNo matter what you say,\nI won't let you take<1\"\u0000>\na single step furhter\nfrom here!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gah...\nDon't you dare think you<1\"\u0000>\ncan get out of here...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gugugu, gigigi, can not go,\nany furhter, goo...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gugu, gigi, I will destroy\nyou...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gugu, confirm cowardness,\nconfirmed...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gugu, gigi, must block path,\ncan not go any furhter, goo...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Gugu, gigi...gi...\nwill...finish...job...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hehehe! Some yummy snack is\nwalking towards me...<1\"\u0000>\nHehehe! Where in the world\ndo you think you're going?<1\"\u0000>\nYou won't be able to get\npast me anyway, so let me<1\"\u0000>\njust devour you! Hehehe!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hehehe!\nWell then, let's dig in!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What's the problem? Trying to\nrun away?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hehe! So you've decided to get\ndevoured by me after all?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Guh...! Who in the world are\nyou to defeat me...?<1\"\u0000>\nY-you won't be able to\nget out of here anyway...<1\"\u0000>\nGuh...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hey, wait a minute! You're a\nDenpa Man, aren't you?<1\"\u0000>\nI've been ordered by\na certain someone not to<1\"\u0000>\nlet a single Denpa Men through\nhere. Just go home quietly!<1\"\u0000>\nIf you absolutely have to get\nthrough, then you must use<1\"\u0000>\nbrue force!!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Hmm...\nYou're saying you'll keep<1\"\u0000>\ngoing even if it means\nhaving to defeat me?<1\"\u0000>\nThat takes some guts!\nI'll stuff you right<1\"\u0000>\ninto my spacious stomach!!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "It's for your own good.\nPick up a rock or something<1\"\u0000>\nas a souvenir on your\nway home!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What's the problem? No matter\nhow often you return to me,<1\"\u0000>\nI will not let you\nthrough!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Ugh...\nYou're going to regret<1\"\u0000>\nthis later...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Clank! Clank! Life Form\nDetected! Program Now<1\"\u0000>\nSwitching To Elimination\nMode As Instructed!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Highest-Level Combat Readiness\nInitiated! Click-clack!<1\"\u0000>\nBeeeeeeeeeeeeeeep!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Enemy Fleeing! Click-clack!!!\nBeeeeeeeeeeeeeeep!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Clank! Clank! Lifeform Returned!\nAs Instructed, Again Switching<1\"\u0000>\nTo Elimination Mode!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Clank! Clank...Cl..cl..cla...\nBeeeeep!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "There's still more to come,\nbut let's leave for now.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "⟏⟦DEC0⟧묯⟦DCB7⟧넯⟦D927⟧쒹糞➺뛝⟦DCB2⟧먯쾺쌧웞밯쌾몵딧⸮",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Shall we head back for now?\nLet's save exploring the<1\"\u0000>\nrest for another time.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "➺뛝⟦DCB2⟧먯쎺⿞뒶쿘꺼딧⺶딮렧⾴➲즸糜샏먯⟦DD27⟧⟦DEC4⟧볆볏떮⸮",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Let's call it a day here.\nI think you'd call this<1\"\u0000>\na strategic retreat.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "➺뛝⟦DCB2⟧먯쎺⿞뒶쿘꺼딧⸮⟦DDBE⟧곘㺸럃⼾꿃닀닄⾳⟔숱⟦DEC3⟧좽⸮",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm seriously exhausted, so let's\nhead back! But I hope we<1\"\u0000>\ncan go even further\nin next time!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "㺸쯀⟞쇚켯꼧뛀糗뒶⟛⾵⟦DEBE⟧⸮⟦DEC3⟧팧쉼⟦DFB7⟧⟦DC27⟧팯꼧⿄➵쾸⟦DEC3⟧눯⟦D9B9⟧⿄➲얰.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": true,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm tired, so let's go home!\nNext time, we'll surely<1\"\u0000>\ngo even further in!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "㻂➶쇚꾬뛀⿗뒶⟛낵쉼⟦DFB7⟧⟦DC27⟧팯꼧⿄➵쾸⟦DEC3⟧눯㺷⟀좲.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": true,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Shall we head home for now?\nIf you push ourselves<1\"\u0000>\ntoo hard, it'll just be\ndetrimental to us!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "➺뛝⟦DCB2⟧똯⟦D8B4⟧볏➮딷㾶⟑볘봾⟦DFB7⟧쓙㍼쪵쀧웞⟦DC2F⟧⟙⟦DCB2⟧⸮",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "I'm still fine, but if you say\nso, I guess we'll head home.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "샜⟦DCBC⟧켯쀧쿞⟦DEC0⟧쀯닞⟦DEBC⟧➮첰엞색뛞糟킷⟦DFB6⟧뼯햰얰휧ⸯ뒶⟛뚵⻈.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": true,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "So I guess we're heading home\nfrom here this time.<1\"\u0000>\nWell, we shouldn't push\nourselves too hard.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "➺뛝⟦DCB2⟧먯쎺⿞뒶⟙⟦DD33⟧⟦DEC3⟧좽⺰켮뀧텼⟦D827⟧⿜⟦DDB7⟧싓⟦DEC3⟧봧⻖.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": true,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "There, tales about terrifying\ndragon, lurking deep within<1\"\u0000>\nthis place, would frequently\nemerge, attack village<1\"\u0000>\nMe heard, hero went to\nslay it, me wonder, what<1\"\u0000>\nhappened to this hero...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Monster up ahead, stole my\ngold! When tried, get back,<1\"\u0000>\nmonster ran way...\nThis, total nightmare...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "While monster chased me,\nended up, in this place here!<1\"\u0000>\nIf think, you in trouble,\nlook for stairs right away,<1\"\u0000>\nand keep move forward",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me heard, spot around here,\nhave lots of monster,<1\"\u0000>\ndropping lots of gold.\nBut me seem, very unlucky.<1\"\u0000>\nMe, not can get there...",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "You guys, adventures too?\nMy name, <17\u0003>{8, MessageNpcName, +}<2\u0010耀>{4, message}.<1\"\u0000>\nMe, been exploring cave!\nBut can't make any further<1\"\u0000>\nprogress alone... You mind,\ntaking me with you?<1\"\u0000>\nHave special skill, can break\nopponent shield effect.<1\"\u0000>\nWhat you say? Want me,\njoin you?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me like attitude!\nCounting on you from now on.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me like attitude!...Wait, your\nisland already full?<1\"\u0000>\nIf have free spot in\nDenpa Men Box, call again!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "What pity... Me believe, can\nbe of some use, not?",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Me, head home ahead of you, so\nif need me, come to<1\"\u0000>\nDenpa Men Box!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Sorry, but island already full!\nIf spot open up in<1\"\u0000>\nDenpa Men Box, call again!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
