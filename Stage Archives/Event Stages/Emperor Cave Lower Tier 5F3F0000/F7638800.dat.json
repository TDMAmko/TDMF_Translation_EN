			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "The stairs I came down with\nare gone!! If there's<1\"\u0000>\nno turning back, we have\nno other choice but to<1\"\u0000>\nkeep going.",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
