			"hasEntryInOffsetOffsets": true,
			"noTerminator": true,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "The stairs just have\ndisappeared! If we keep<1\"\u0000>\ngoing, will we find\nthe exit?",
