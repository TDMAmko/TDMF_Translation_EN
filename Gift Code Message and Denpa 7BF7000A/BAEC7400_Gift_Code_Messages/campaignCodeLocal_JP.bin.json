	"text_info": [
		{
			"text_contents": "Thank you for playing our\ngame. To celebrate the release\nof an previous update,\nwe're giving away Jewels!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
		{
			"text_contents": "Thank you for following\nKawasaki-san on Miiverse.\nTo show our appreciation for\n10,000 followers, we'll\ngive away Jewels as gift!",
			"hasEntryInOffsetOffsets": true,
			"noTerminator": false,
			"manualOffset": 0,
			"hasManualOffset": false
		},
